{
  "lastChangelogVersion": "0.84.2",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.6-sol",
  "defaultThinkingLevel": "max",
  "subagents": {
    "agentOverrides": {
      "reviewer": {
        "thinking": "max"
      }
    }
  },
  "pi-gpt-fast-mode": {
    "enabled": true
  },
  "compaction": {
    "enabled": true,
    "reserveTokens": 64000,
    "keepRecentTokens": 30000
  },
  "terminal": {
    "showTerminalProgress": true,
    "showImages": true
  },
  "theme": "ghostty-sync-545c9bd8",
  "packages": [
    "npm:@ogulcancelik/pi-ghostty-theme-sync",
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:@juicesharp/rpiv-web-tools",
    "npm:@danchamorro/pi-prompt-enhancer",
    "npm:pi-rtk-optimizer",
    "npm:pi-subagents",
    "npm:@juicesharp/rpiv-todo",
    "npm:@juicesharp/rpiv-advisor",
    "npm:@juicesharp/rpiv-btw",
    "npm:@juicesharp/rpiv-i18n",
    "npm:@juicesharp/rpiv-args",
    "npm:@aliou/pi-processes",
    "npm:@narumitw/pi-goal",
    {
      "source": "npm:pi-cmux",
      "skills": [],
      "prompts": []
    },
    "npm:pi-skill-arg-hints",
    "npm:pi-mcp-adapter",
    "npm:pi-paster",
    "npm:pi-memory"
  ],
  "extensions": [
    "-extensions/codex-usage-status/index.ts",
    "-extensions/kimi-usage-status/index.ts",
    "-extensions/qwen-usage.ts"
  ],
  "shellPath": "/opt/homebrew/bin/fish",
  "hideThinkingBlock": false,
  "tuiMode": "fullscreen"
}
